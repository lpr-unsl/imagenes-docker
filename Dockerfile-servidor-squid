FROM sistemasoperativostur/netoslab-router:latest
LABEL mantainer=”ctaffer@unsl.edu.ar”
WORKDIR /root
# squid service also apache2 is needed
RUN apt update \
    && apt install -y \
       squid \
       apache2 \
    && apt clean \
    && apt -y autoremove \
    && rm -rf /var/lib/apt/lists/*
COPY resources/nsswitch.conf /etc/nsswitch.conf
CMD ["/bin/bash"]
